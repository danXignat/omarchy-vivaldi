  "setup.default.browser.vivaldi": {"icon":"󰖟","label":"Vivaldi","when":"[[ -x $HOME/.config/omarchy/plugins/io.github.danxignat.vivaldi/bin/vivaldi-omarchy ]] && omarchy-cmd-present vivaldi-stable","checked":"[[ \"$(omarchy-default-browser)\" == \"vivaldi-stable.desktop\" ]]","action":"$HOME/.config/omarchy/plugins/io.github.danxignat.vivaldi/bin/vivaldi-omarchy default"},
  "install.browser.vivaldi": {"icon":"󰖟","label":"Vivaldi","when":"[[ -x $HOME/.config/omarchy/plugins/io.github.danxignat.vivaldi/bin/vivaldi-omarchy ]] && ! omarchy-pkg-present vivaldi","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-pkg-add vivaldi'"},
  "remove.browser.vivaldi": {"icon":"󰖟","label":"Vivaldi","when":"[[ -x $HOME/.config/omarchy/plugins/io.github.danxignat.vivaldi/bin/vivaldi-omarchy ]] && omarchy-pkg-present vivaldi","action":"omarchy-launch-floating-terminal-with-presentation \"$HOME/.config/omarchy/plugins/io.github.danxignat.vivaldi/bin/vivaldi-omarchy remove\""},
